            <span className="font-bold text-lg hidden sm:inline text-foreground">SmartTourist</span>
          </div>

          {/* Desktop Menu */}
          <div className="hidden md:flex items-center gap-8">
            {!isAuthenticated ? (
              <>
                <Button

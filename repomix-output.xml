  draft: 'bg-muted text-muted-foreground',
  planning: 'bg-blue-100 text-blue-800',
  booked: 'bg-green-100 text-green-800',
  in_progress: 'bg-purple-100 text-purple-800',
  completed: 'bg-gray-100 text-gray-800',
